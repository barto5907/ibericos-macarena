# Copia este archivo a .env y ajusta los valores.
# El archivo .env NUNCA se sube a Git.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4000

# Clave para firmar las sesiones (mínimo 32 caracteres).
# Este valor es solo de desarrollo: en producción el servidor no arranca con él.
# Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_secret_cambiame_dev_secret_cambiame_dev_secret
JWT_EXPIRES_IN=7d

COOKIE_NAME=im_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# PostgreSQL. Si se deja vacía, el servidor arranca en modo memoria con datos de ejemplo.
# Ejemplo: postgresql://usuario:contraseña@localhost:5432/ibericos_macarena?schema=public
DATABASE_URL=

LOG_LEVEL=info
